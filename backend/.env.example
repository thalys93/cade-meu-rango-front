# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

# ── Server ────────────────────────────────────
PORT=3001
NODE_ENV=development
API_VERSION=v0
FRONTEND_URL=http://localhost:5173

# ── Branding ──────────────────────────────────
APP_NAME=Cadê Meu Rango
API_TITLE=Cadê Meu Rango API
SWAGGER_DESCRIPTION=API documentation for Cadê Meu Rango
APP_LOGO_URL=https://res.cloudinary.com/dh39ahmpj/image/upload/v1683412274/favicons.dev/cade_meu_rango_nyjbxs.png

# ── Feature Flags ─────────────────────────────
FEATURE_SEEDING=true

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cade_meu_rango_db

# ── JWT ───────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── Mail ──────────────────────────────────────
MAIL_DRIVER=console
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_SUPPORT_EMAIL=

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
